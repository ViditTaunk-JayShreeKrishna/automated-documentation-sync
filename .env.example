DOCSYNC_JIRA_ACCESS_TOKEN=replace-with-jira-scoped-api-token
DOCSYNC_GITHUB_ACCESS_TOKEN=replace-with-fine-grained-github-token
DOCSYNC_CONFLUENCE_ACCESS_TOKEN=replace-with-confluence-scoped-api-token
DOCSYNC_ATLASSIAN_ACCOUNT_EMAIL=replace-with-atlassian-account-email
DOCSYNC_ATLASSIAN_CLOUD_ID=replace-with-atlassian-cloud-id
# Optional: configure only when the matching sender is ready. Use distinct,
# randomly generated secrets of at least 32 bytes; never commit actual values.
# DOCSYNC_JIRA_WEBHOOK_SECRET=replace-with-random-jira-webhook-secret
# DOCSYNC_GITHUB_WEBHOOK_SECRET=replace-with-random-github-webhook-secret
